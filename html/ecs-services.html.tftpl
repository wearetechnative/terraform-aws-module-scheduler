<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#112f41">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <title>ECS services · Instance Scheduler</title>
  <script src="auth.js"></script>
  <style>
    :root { --ink:#112f41;--muted:#607582;--line:#dce7eb;--paper:#f3f7f8;--accent:#72c8d3;--dark:#112f41;--danger:#a93838; }
    * { box-sizing:border-box } body { margin:0;color:var(--ink);background:var(--paper);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif } a { color:inherit;text-decoration:none } button,input,select { font:inherit }
    .shell { min-height:100vh;display:grid;grid-template-columns:248px 1fr }.sidebar { position:sticky;top:0;height:100vh;padding:28px 20px;background:var(--dark);color:#fff;display:flex;flex-direction:column }.brand { display:block;margin-bottom:28px;padding:10px 12px;border-radius:12px;background:#fff }.brand-logo { display:block;width:100%;height:auto }.nav-label { margin:0 10px 9px;color:#89938e;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.11em }.nav { display:grid;gap:6px }.nav a { display:flex;gap:12px;align-items:center;padding:11px 12px;border-radius:10px;color:#aeb8b2;font-weight:600 }.nav a:hover,.nav a.active { color:#fff;background:#1b4359 }.nav a.active::before { content:"";width:4px;height:18px;border-radius:9px;background:var(--accent);margin-left:-12px }.nav svg { width:18px;height:18px }.sidebar-foot { margin-top:auto;padding:16px;border:1px solid #35413b;border-radius:14px;color:#9da8a2;font-size:12px }.sidebar-foot strong { display:block;color:#fff;font-size:13px;margin-bottom:4px }
    main { padding:36px 44px 60px;min-width:0 }.topbar { display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:28px }.eyebrow { margin:0 0 5px;color:var(--muted);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.12em } h1 { margin:0;font-size:clamp(30px,3vw,42px);line-height:1.08;letter-spacing:-.045em }.subtitle { margin:8px 0 0;color:var(--muted) }.btn { min-height:40px;padding:0 14px;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:9px;background:var(--dark);color:#fff;cursor:pointer;font-weight:700 }.btn:disabled { cursor:not-allowed;opacity:.5 }.btn.ghost { color:var(--muted);background:#eef1ec }.btn.danger { color:var(--danger);background:#fff0f0 }
    .summary { display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:20px }.summary-card { padding:18px 20px;background:#fff;border:1px solid var(--line);border-radius:14px }.summary-card span { color:var(--muted);font-size:12px;font-weight:650 }.summary-card strong { display:block;margin-top:4px;font-size:23px;letter-spacing:-.03em }.panel { background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden }.toolbar { display:flex;justify-content:space-between;align-items:center;gap:16px;padding:17px 20px;border-bottom:1px solid var(--line) }.search { width:min(360px,100%) }.search input { width:100%;height:41px;padding:0 12px;border:1px solid var(--line);border-radius:9px;background:#fafbf9;outline:none }.count,.meta { color:var(--muted);font-size:12px }.table-wrap { overflow-x:auto } table { width:100%;min-width:1050px;border-collapse:collapse } th { padding:13px 18px;color:var(--muted);background:#fafbf9;border-bottom:1px solid var(--line);text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.08em } td { padding:15px 18px;border-bottom:1px solid var(--line);vertical-align:middle } tbody tr:last-child td { border-bottom:0 }.service-name { font-weight:730 }.service-arn { max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted);font-size:11px }.state { display:inline-flex;align-items:center;gap:7px;padding:5px 9px;border-radius:999px;font-size:11px;font-weight:750;text-transform:capitalize }.state::before { content:"";width:6px;height:6px;border-radius:50%;background:currentColor }.state.active { color:#25704b;background:#eaf7ef }.state.inactive,.state.draining { color:#806a28;background:#f8f3dd }.assignment,.override { display:flex;align-items:center;gap:8px }.assignment select { width:170px;height:39px;padding:0 10px;border:1px solid #d6dbd7;border-radius:9px;background:#fff;color:var(--ink) }.override-value { color:#806a28;font-size:11px;font-weight:700 }.unmanaged { color:#8a6c2f;font-size:11px;font-weight:700 }.state-message { padding:65px 20px;text-align:center;color:var(--muted) }.state-message strong { display:block;color:var(--ink);margin-bottom:5px }
    dialog { width:min(460px,calc(100% - 32px));padding:0;border:0;border-radius:18px;color:var(--ink);box-shadow:0 24px 80px rgba(23,32,28,.25) } dialog::backdrop { background:rgba(16,24,20,.55);backdrop-filter:blur(3px) }.dialog-head { padding:22px 24px 17px;border-bottom:1px solid var(--line) }.dialog-head h2 { margin:0 0 5px;font-size:20px }.dialog-head p { margin:0;color:var(--muted);font-size:13px }.dialog-body { display:grid;gap:17px;padding:22px 24px }.field label { display:block;margin-bottom:6px;font-size:12px;font-weight:750 }.field input,.field select { width:100%;height:43px;padding:0 12px;border:1px solid #d6dbd7;border-radius:9px;background:#fff }.dialog-actions { display:flex;justify-content:space-between;gap:9px;padding:17px 24px;border-top:1px solid var(--line);background:#fafbf9 }.dialog-actions-right { display:flex;gap:9px;margin-left:auto }.toast { position:fixed;right:24px;bottom:24px;max-width:380px;padding:13px 16px;border-radius:11px;background:var(--dark);color:#fff;opacity:0;pointer-events:none;transition:.2s }.toast.show { opacity:1 }.toast.error { background:#8d3030 }
    @media(max-width:900px){.shell{grid-template-columns:1fr}.sidebar{position:static;height:auto;padding:18px 20px}.nav-label,.sidebar-foot{display:none}.nav{display:flex;overflow-x:auto}.nav a{white-space:nowrap}main{padding:28px 20px 50px}.summary{grid-template-columns:1fr 1fr}} @media(max-width:600px){.topbar,.toolbar{align-items:flex-start;flex-direction:column}.summary{grid-template-columns:1fr}.search{width:100%}}
  </style>
</head>
<body><div class="shell">
  <aside class="sidebar"><a class="brand" href="index.html"><img class="brand-logo" src="technativelogo.svg" alt="TechNative"></a><p class="nav-label">Workspace</p><nav class="nav">
    <a href="index.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg> Overview</a>
    <a href="schedules.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg> Schedules</a>
    <a href="periods.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> Periods</a>
    <a href="instances.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/></svg> EC2 instances</a>
    <a class="active" href="ecs-services.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/><circle cx="7" cy="7" r="1"/><circle cx="7" cy="12" r="1"/><circle cx="7" cy="17" r="1"/></svg> ECS services</a>
  </nav><div class="sidebar-foot"><strong>ECS tag</strong>Assignments are stored in the ServiceScheduler tag.</div></aside>
  <main><header class="topbar"><div><p class="eyebrow">ECS inventory</p><h1>ECS services</h1><p class="subtitle">See service capacity and manage scheduler assignments.</p></div><button class="btn ghost" id="refreshButton">Refresh</button></header>
    <section class="summary"><div class="summary-card"><span>Total services</span><strong id="totalCount">—</strong></div><div class="summary-card"><span>Managed</span><strong id="managedCount">—</strong></div><div class="summary-card"><span>Unmanaged</span><strong id="unmanagedCount">—</strong></div></section>
    <section class="panel"><div class="toolbar"><div class="search"><input id="search" type="search" placeholder="Search service, cluster, schedule…" aria-label="Search ECS services"></div><div class="count" id="resultCount">Loading services…</div></div><div class="table-wrap"><table><thead><tr><th>Service</th><th>Status</th><th>Tasks</th><th>Launch type</th><th>Schedule assignment</th><th>Ignore scheduler</th></tr></thead><tbody id="serviceRows"><tr><td colspan="6"><div class="state-message">Loading ECS inventory…</div></td></tr></tbody></table></div></section>
  </main></div>
  <dialog id="ignoreDialog"><form id="ignoreForm"><div class="dialog-head"><h2>Ignore scheduler</h2><p id="ignoreService"></p></div><div class="dialog-body"><div class="field"><label for="ignoreTime">Ignore until</label><input id="ignoreTime" type="time" required></div><div class="field"><label for="ignoreTimezone">Timezone</label><select id="ignoreTimezone" required><option>Europe/Amsterdam</option><option>Europe/London</option><option>UTC</option><option>America/New_York</option><option>America/Los_Angeles</option><option>Asia/Kolkata</option><option>Asia/Singapore</option><option>Australia/Sydney</option></select></div></div><div class="dialog-actions"><button class="btn danger" type="button" id="removeIgnore">Remove override</button><div class="dialog-actions-right"><button class="btn ghost" type="button" id="cancelIgnore">Cancel</button><button class="btn" type="submit" id="saveIgnore">Save override</button></div></div></form></dialog>
  <div class="toast" id="toast" role="status"></div>
  <script>
    const apiUrl='${api_url}'; const rows=document.getElementById('serviceRows'); let services=[]; let schedules=[]; let selectedService=null;
    function request(path,options){return fetch(apiUrl+path,options).then(function(response){return response.text().then(function(text){let data={};try{data=text?JSON.parse(text):{}}catch(error){data={message:text}}if(!response.ok)throw new Error(data.message||'Request failed');return data})})}
    function toast(message,isError){const element=document.getElementById('toast');element.textContent=message;element.className='toast show'+(isError?' error':'');window.setTimeout(function(){element.className='toast'},2800)}
    function updateSummary(){const managed=services.filter(function(service){return service.schedule}).length;document.getElementById('totalCount').textContent=services.length;document.getElementById('managedCount').textContent=managed;document.getElementById('unmanagedCount').textContent=services.length-managed}
    function visibleServices(filter){const query=(filter||'').trim().toLowerCase();return services.filter(function(service){return [service.service_name,service.service_arn,service.cluster_name,service.schedule,service.launch_type].some(function(value){return (value||'').toLowerCase().includes(query)})})}
    function render(filter){const visible=visibleServices(filter);document.getElementById('resultCount').textContent=visible.length+(visible.length===1?' service':' services');rows.innerHTML='';if(!visible.length){rows.innerHTML='<tr><td colspan="6"><div class="state-message"><strong>No ECS services found</strong>Try another search or check this AWS region.</div></td></tr>';return}visible.forEach(renderRow)}
    function renderRow(service){const row=document.createElement('tr');const identity=document.createElement('td');identity.innerHTML='<div class="service-name"></div><div class="meta"></div><div class="service-arn"></div>';identity.children[0].textContent=service.service_name;identity.children[1].textContent=service.cluster_name;identity.children[2].textContent=service.service_arn;identity.children[2].title=service.service_arn;
      const statusCell=document.createElement('td');const status=document.createElement('span');status.className='state '+service.status.toLowerCase();status.textContent=service.status;statusCell.appendChild(status);const tasks=document.createElement('td');tasks.innerHTML='<strong></strong><div class="meta"></div>';tasks.children[0].textContent=service.running_count+' / '+service.desired_count;tasks.children[1].textContent=service.pending_count+' pending';const launch=document.createElement('td');launch.textContent=service.launch_type||service.scheduling_strategy||'—';
      const assignmentCell=document.createElement('td');const assignment=document.createElement('div');assignment.className='assignment';const select=document.createElement('select');const empty=document.createElement('option');empty.value='';empty.textContent='No schedule';select.appendChild(empty);schedules.forEach(function(schedule){const option=document.createElement('option');option.value=schedule;option.textContent=schedule;select.appendChild(option)});if(service.schedule&&!schedules.includes(service.schedule)){const unknown=document.createElement('option');unknown.value=service.schedule;unknown.textContent=service.schedule+' (missing)';select.appendChild(unknown)}select.value=service.schedule||'';const save=document.createElement('button');save.className='btn';save.textContent=service.schedule?'Update':'Assign';save.disabled=true;select.addEventListener('change',function(){save.disabled=select.value===(service.schedule||'');save.textContent=select.value?(service.schedule?'Update':'Assign'):'Remove'});save.addEventListener('click',function(){updateAssignment(service,select,save)});assignment.appendChild(select);assignment.appendChild(save);assignmentCell.appendChild(assignment);
      const ignoreCell=document.createElement('td');const ignore=document.createElement('div');ignore.className='override';const value=document.createElement('span');value.className=service.ignore_scheduler?'override-value':'unmanaged';value.textContent=service.ignore_scheduler||'No override';const button=document.createElement('button');button.className='btn ghost';button.textContent=service.ignore_scheduler?'Edit':'Set';button.addEventListener('click',function(){openIgnoreDialog(service)});ignore.appendChild(value);ignore.appendChild(button);ignoreCell.appendChild(ignore);[identity,statusCell,tasks,launch,assignmentCell,ignoreCell].forEach(function(cell){row.appendChild(cell)});rows.appendChild(row)}
    function updateAssignment(service,select,button){const next=select.value;const action=next?'assign “'+next+'” to':'remove the schedule from';if(!window.confirm('Do you want to '+action+' '+service.service_name+'?')){select.value=service.schedule||'';button.disabled=true;return}button.disabled=true;button.textContent='Saving…';request('/ecs-services/schedule',{method:'POST',headers:{'Content-Type':'text/plain;charset=UTF-8'},body:JSON.stringify({cluster_arn:service.cluster_arn,service_arn:service.service_arn,schedule_name:next})}).then(function(){service.schedule=next;toast(next?'Schedule assigned':'Schedule removed');updateSummary();render(document.getElementById('search').value)}).catch(function(error){select.value=service.schedule||'';button.disabled=false;button.textContent='Retry';toast(error.message||'Could not update service',true)})}
    function load(){document.getElementById('refreshButton').disabled=true;rows.innerHTML='<tr><td colspan="6"><div class="state-message">Loading ECS inventory…</div></td></tr>';Promise.all([request('/ecs-services'),request('/db')]).then(function(results){services=results[0].services||[];schedules=results[1].schedules_list||[];updateSummary();render(document.getElementById('search').value)}).catch(function(error){rows.innerHTML='<tr><td colspan="6"><div class="state-message"><strong>Could not load ECS services</strong>'+String(error.message||'Check ECS permissions and API connectivity.')+'</div></td></tr>';toast('Could not load ECS services',true)}).finally(function(){document.getElementById('refreshButton').disabled=false})}
    function openIgnoreDialog(service){selectedService=service;document.getElementById('ignoreService').textContent=service.service_name+' will remain running until this local time.';const parts=(service.ignore_scheduler||'').split(' ');document.getElementById('ignoreTime').value=parts[0]&&parts[0].includes(':')?parts[0]:'';document.getElementById('ignoreTimezone').value=parts.slice(1).join(' ')||'Europe/Amsterdam';document.getElementById('removeIgnore').style.visibility=service.ignore_scheduler?'visible':'hidden';document.getElementById('ignoreDialog').showModal()}
    function updateIgnore(time,timezone){if(!selectedService)return;const save=document.getElementById('saveIgnore');save.disabled=true;request('/ecs-services/ignore',{method:'POST',headers:{'Content-Type':'text/plain;charset=UTF-8'},body:JSON.stringify({cluster_arn:selectedService.cluster_arn,service_arn:selectedService.service_arn,ignore_until:time,timezone:timezone})}).then(function(data){selectedService.ignore_scheduler=data.ignore_scheduler||'';document.getElementById('ignoreDialog').close();toast(data.ignore_scheduler?'Scheduler override assigned':'Scheduler override removed');render(document.getElementById('search').value)}).catch(function(error){toast(error.message||'Could not update override',true)}).finally(function(){save.disabled=false})}
    document.getElementById('search').addEventListener('input',function(event){render(event.target.value)});document.getElementById('refreshButton').addEventListener('click',load);document.getElementById('cancelIgnore').addEventListener('click',function(){document.getElementById('ignoreDialog').close()});document.getElementById('removeIgnore').addEventListener('click',function(){if(window.confirm('Remove the Ignore_scheduler override from this service?'))updateIgnore('','')});document.getElementById('ignoreForm').addEventListener('submit',function(event){event.preventDefault();updateIgnore(document.getElementById('ignoreTime').value,document.getElementById('ignoreTimezone').value)});load();
  </script>
</body></html>
